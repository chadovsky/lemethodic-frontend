# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (machine-local)
.claude/*

# Carve out authored Claude Code content
!.claude/skills/
!.claude/agents/
!.claude/commands/

# Playwright capture output — all off per M2 ops (drive constraint, 2026-05-30)
test-results/
playwright-report/
tests/screenshots/
tests/traces/
tests/videos/

# t5 dark mode gallery — visual review artifact, not committed
t5-dark-mode-gallery/

.impeccable/

# M0 audit auth state — contains JWT, never commit
audit-auth.json
audit-auth-verified.json

# Auto-generated audit artifacts -- re-written every dispatch, never commit
docs/audit-screenshots/
e2e-results.txt
