# Backend API base URL (no trailing slash).
# Local dev:   http://localhost:8000
# Production:  https://seal-app-75fiu.ondigitalocean.app
#
# The NEXT_PUBLIC_ prefix is required — Next.js only exposes env vars with
# this prefix to the browser. Without it, lib/api.ts reads an empty string.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Plausible Analytics — set to your Plausible site domain to activate.
# Example: NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lemethodic.com
# Omit or leave blank in local dev; script is suppressed when unset.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# OG image fallback — absolute URL or root-relative path to a 1200x630 JPEG.
# Example: NEXT_PUBLIC_OG_IMAGE=/og-default.jpg
# Place the file at public/og-default.jpg first, then set this var.
# Omit until the image is created; no OG image is better than a 404.
NEXT_PUBLIC_OG_IMAGE=

# ── Payload CMS ────────────────────────────────────────────────────────────────
#
# Postgres connection string for the payload_cms schema on the existing
# DigitalOcean Postgres instance (Option A, approved 2026-06-01).
#
# Local dev: spin up a Postgres container and create the payload_cms schema:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=payload postgres:16
#   psql -h localhost -U postgres -c "CREATE SCHEMA payload_cms;"
#   Then set: DATABASE_URI=postgres://postgres:payload@localhost:5432/postgres
#
# Production: founder provides a dedicated DO Postgres user scoped to the
# payload_cms schema only. DO NOT commit a production connection string here.
DATABASE_URI=

# Secret key used by Payload to sign auth cookies and tokens.
# Generate one: openssl rand -hex 32
# Must be set in both local dev and Vercel production env.
PAYLOAD_SECRET=

# DigitalOcean Spaces credentials for CMS media uploads.
# The project already uses DO Spaces (fra1) for audio via the BE.
# CMS uploads land under the /cms prefix in the bucket below.
# Reuse the same Spaces bucket or create a dedicated one.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
# Region defaults to fra1 (DigitalOcean Frankfurt, where the project's infra lives).
DO_SPACES_REGION=fra1
